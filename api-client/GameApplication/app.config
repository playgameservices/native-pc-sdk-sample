<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <AppDetails>
    <add key="name" value="GameApplication" />
  </AppDetails>
  <appSettings>
    <!-- SECURITY: Never commit real client_secret values. Set GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET in your environment. -->
    <add key="client_id" value="YOUR_OAUTH_DESKTOP_CLIENT_ID"/>
    <add key="redirect_uri" value="http://127.0.0.1:8080/"/>
    <add key="authorization_Endpoint" value="https://accounts.google.com/o/oauth2/v2/auth"/>
    <add key="Scopes" value="https://www.googleapis.com/auth/googleplay.products%20https://www.googleapis.com/auth/googleplay.purchases"/>
    <add key="tokenEndpoint" value="https://oauth2.googleapis.com/token"/>
  </appSettings>
</configuration>
